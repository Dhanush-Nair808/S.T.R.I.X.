# STRIX environment configuration example
# Rename to .env and replace the placeholder values before running the app.

GOOGLE_API_KEY=your_google_api_key_here
EMAIL_SENDER=alerts@yourdomain.com
EMAIL_PASSWORD=your_email_app_password_here
EMAIL_RECEIVER=admin@yourdomain.com
STRIX_API_URL=http://127.0.0.1:8000
